  "query": "INSERT INTO clientes (id, nombre, telefono, origen) VALUES (gen_random_uuid(), $1, $2, $3) ON CONFLICT (telefono) DO UPDATE SET nombre = COALESCE(NULLIF(EXCLUDED.nombre, ''), clientes.nombre), updated_at = NOW() RETURNING id, nombre, telefono, origen, interes, presupuesto, zona, notas, created_at, updated_at",
