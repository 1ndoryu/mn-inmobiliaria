  "db_name": "PostgreSQL",
  "query": "SELECT c.id, c.nombre, c.telefono, c.origen, c.interes, c.presupuesto, c.zona, c.notas, (SELECT COUNT(*) FROM canal_sesiones cs WHERE cs.cliente_id = c.id) AS sesiones, c.created_at, c.updated_at FROM clientes c WHERE ($1::TEXT IS NULL OR c.nombre ILIKE '%' || $1 || '%' OR c.telefono ILIKE '%' || $1 || '%') ORDER BY c.updated_at DESC LIMIT $2",
