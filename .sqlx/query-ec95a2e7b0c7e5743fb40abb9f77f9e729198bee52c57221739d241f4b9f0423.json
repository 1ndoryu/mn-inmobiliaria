  "query": "SELECT date_trunc('day', created_at)::DATE AS \"dia?\", sender AS \"remitente?\", COUNT(*) AS \"mensajes?\", SUM(tokens_est) AS \"tokens_est?\", SUM(COALESCE(tokens_in, 0)) AS \"tokens_in?\", SUM(COALESCE(tokens_out, 0)) AS \"tokens_out?\" FROM uso_mensajes WHERE created_at >= NOW() - ($1::text || ' days')::INTERVAL GROUP BY 1, 2 ORDER BY 1 DESC, 2",
