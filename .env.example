# Base de datos PostgreSQL
DATABASE_URL=postgres://postgres:password@localhost:5432/glory_db

# Secret para firmar tokens JWT — cambiar en producción
JWT_SECRET=change-this-to-a-random-secret-key-at-least-32-chars

# Servidor
HOST=127.0.0.1
PORT=3000

# Volumen local de fotos subidas (servido en /uploads, gitignored)
UPLOAD_DIR=./uploads

# Centro de IA de texto [199A-1]: las claves viven solo aqui, nunca en Configuracion.
# GLORY_API_URL por defecto http://127.0.0.1:3101 si se deja vacio.
GLORY_API_URL=
GLORY_API_KEY=
OPENCODE_GO_API_KEY=

# Logging (trace, debug, info, warn, error)
RUST_LOG=glory_backend=debug,tower_http=debug
