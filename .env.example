# Base de datos PostgreSQL
DATABASE_URL=postgres://postgres:password@localhost:5432/glory_db

# Secret para firmar tokens JWT — cambiar en producción
JWT_SECRET=change-this-to-a-random-secret-key-at-least-32-chars

# Servidor (local en 3110 [03AA-1]: el 3000 lo ocupa glory-pulse; prod usa 3000 vía Dockerfile)
HOST=127.0.0.1
PORT=3110

# Volumen local de fotos subidas (servido en /uploads, gitignored)
UPLOAD_DIR=./uploads

# Base pública para `media_url` de fotos que la IA envía por WhatsApp [299A-1 E13]:
# en producción lleva el dominio público (los servidores de WhatsApp la descargan).
# En el dev público de la 89 la fija `botonRemoto` (registro.json), no este archivo:
# PUBLIC_BASE_URL=https://mn-dev.wandori.us/rust
PUBLIC_BASE_URL=http://127.0.0.1:3110
# [15AA-6] Manda sobre PUBLIC_BASE_URL para las fotos que la IA envía por WhatsApp.
# Si el dominio público está detrás de Cloudflare Access, ponlo aquí apuntando a
# algo que el gateway alcance (p. ej. el túnel interno).
# MEDIA_BASE_URL=

# Centro de IA de texto [199A-1]: las claves viven solo aqui, nunca en Configuracion.
# GLORY_API_URL por defecto http://127.0.0.1:3101 si se deja vacio.
GLORY_API_URL=
GLORY_API_KEY=
OPENCODE_GO_API_KEY=

# Logging (trace, debug, info, warn, error)
RUST_LOG=glory_backend=debug,tower_http=debug

# Gateway Baileys (289A-1): worker -> http://127.0.0.1:3102/send
GLORY_ALERT_GATEWAY_URL=http://127.0.0.1:3102/send
# Secreto compartido worker->gateway (cabecera X-Gateway-Secret); vacio = sin exigir
GATEWAY_SEND_SECRET=
# Secreto gateway->backend (cabecera X-Gateway-Secret en /agent/whatsapp/webhook)
WA_WEBHOOK_SECRETO=
# Sesiones del gateway (dentro de gateway/): numero propio de cada sesion
SESSION_A_NUMBER=584120825234
SESSION_B_NUMBER=18149575416
# Tercer número (wa_c): mudo por defecto; SESSION_C_NUMBER puede quedar vacío (se lee al vincular)
SESSION_C_NUMBER=
SESSION_C_RESPONDE_IA=0
# [15AA-6] C solo archiva: su inbound se guarda (mensaje + medios) y no responde.
SESSION_C_ARCHIVA=1
# Número de C en el backend (agent_config `wa_numero_c` manda sobre esto).
# Sin fijarlo, el webhook responde 400 numero_destino desconocido.
WA_NUMERO_C=
GATEWAY_PORT=3102
BACKEND_WEBHOOK_URL=http://127.0.0.1:3110/api/agent/whatsapp/webhook
