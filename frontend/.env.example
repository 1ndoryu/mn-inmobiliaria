# Copia a `.env.local` (gitignored, nunca commitear) y rellena la clave.
# La unified-key se obtiene de gloryapi (su bóveda local); el navegador la usa
# solo como Bearer contra el proxy local de Vite (/glory -> 127.0.0.1:3101).

# Base de la API Rust de inmuebles (MN-Inmobiliaria). Por defecto
# http://127.0.0.1:3110 [03AA-1]; solo cambiar si la API corre en otro origen.
# VITE_API_URL=http://127.0.0.1:3110
#
# Dev público (Cloudflare Access) en la 89: `botonRemoto` de registro.json fija
# MN_DEV_PUBLIC_HOST=mn-dev.wandori.us y VITE_API_URL=/rust (mismo origen, sin CORS).
# Sin MN_DEV_PUBLIC_HOST, Vite no acepta otro Host y el dev público da 403.
# MN_DEV_PUBLIC_HOST=mn-dev.wandori.us

# Unified API key de GloryAPI (obligatoria para el botón IA).
VITE_GLORY_API_KEY=

# Base del proxy OpenAI-compatible de GloryAPI. Por defecto el proxy
# mismo-origen de Vite; solo cambiar si gloryapi corre en otro puerto.
# VITE_GLORY_API_URL=/glory

# Mejora de fotos con la suscripción de gemini.google.com/app (vía gemini-webapi).
# SOLO en `.env.local` (gitignored): el mini-backend las lee; el navegador jamás.
# GEMINI_PSID=
# GEMINI_PSIDTS=

# Auto-entrada del panel SOLO en dev [03AA-2]: con hostname de la lista blanca
# (localhost, *.localhost, mn-dev.wandori.us) y la auto-entrada encendida, si no
# hay sesión el front entra solo con estas credenciales (UN intento; si falla
# sale el login normal). En prod jamás se intenta.
# Van SOLO en `.env.local` (gitignored), nunca aquí con valores reales.
# `.env.local` es la fuente de verdad [10AA-27]: `npm run dev:back` reescribe el
# hash del admin de la BD local (solo localhost) si no coincide con esta clave.
# [15AA-1] Espejo en el `.env` de la raíz (gitignored): `up` lo copia a la 89
# para la auto-entrada del dev público `mn-dev.wandori.us` (Access, solo ella).
# En la 89 las dos claves acaban en `frontend/.env.local` (0600): Vite lee su
# propio `envDir`, no el `.env` de la raíz, y ahí es donde las busca.
# VITE_DEV_EMAIL=admin@admin.com
# VITE_DEV_PASSWORD=cambia-esta-clave
# [18AA-1] La escribe el workspace-manager, no tú: en modo build no hay `DEV`,
# así que la auto-entrada la enciende esta bandera. Solo se hornea si la ficha
# del proyecto la pide (`build.autologinDev`); el build de producción no la lleva.
# VITE_DEV_AUTOLOGIN=1

# Throttle del backend (opcionales; por defecto 120s / 30% / 40 por día).
# MEJORA_INTERVALO_SEG=120
# MEJORA_JITTER_PCT=30
# MEJORA_MAX_DIA=40
# MEJORA_PORT=3122
# MEJORA_PYTHON=python

