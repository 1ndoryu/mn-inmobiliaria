{
  "schemaVersion": 2,
  "mode": "enforce",
  "project": {
    "primaryBranch": "main"
  },
  "guard": {
    "directCommands": {
      "npmScripts": [
        "lint",
        "test",
        "build",
        "check"
      ],
      "npxTools": [
        "eslint",
        "tsc",
        "typescript",
        "vitest"
      ],
      "cargoSubcommands": [
        "check",
        "test",
        "clippy",
        "fmt",
        "bench",
        "nextest"
      ],
      "tools": [
        "tsc",
        "vitest",
        "eslint"
      ]
    }
  },
  "analyzers": {
    "sentinel": {
      "enabled": true,
      "profile": "mixed",
      "config": {
        "includePatterns": [
          "**/*.ts",
          "**/*.tsx",
          "**/*.js",
          "**/*.jsx",
          "**/*.css",
          "**/*.rs",
          "Cargo.toml",
          "Cargo.lock",
          "**/*.py"
        ],
        "excludePatterns": [
          "**/node_modules/**",
          "**/dist/**",
          "**/build/**",
          "**/target/**",
          "**/__pycache__/**",
          "**/.venv/**",
          "**/.git/**"
        ],
        "portableBoundaries": {
          "loggerModules": [
            "/gateway/src/"
          ]
        }
      }
    },
    "varsense": {
      "enabled": true,
      "profile": "project-default",
      "config": "varsense.config.json"
    }
  },
  "runtime": {
    "minimumVersion": "0.7.21",
    "protocolVersion": 1,
    "lockFile": "sentinel.lock.json"
  },
  "directoryExceptions": [],
  "rules": {}
}
